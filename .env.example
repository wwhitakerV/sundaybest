# SundayBest environment
#
# Copy this file to `.env` before running the app:
#
#     cp .env.example .env
#
# `.env` is gitignored. `src/core/config/env.ts` parses these at startup and the
# app refuses to launch if any is missing or malformed, so a misconfigured build
# fails immediately instead of producing `undefined` somewhere far from the cause.
#
# ---------------------------------------------------------------------------
# EVERY VALUE IN THIS FILE IS PUBLIC
# ---------------------------------------------------------------------------
# Expo compiles `EXPO_PUBLIC_*` variables into the JavaScript bundle. Anyone who
# downloads the app can read them in plain text — unzip the .ipa and grep. They
# are configuration, not secrets.
#
# Never put an API key, token, signing key, or password here, or in any
# `EXPO_PUBLIC_*` variable, even temporarily. A secret the app genuinely needs at
# runtime belongs behind a server that holds it.
#
# `APP_VARIANT` is deliberately not in this file: it is a build-time variable
# read by app.config.ts to pick the app's name and bundle ID, and it is set by
# the npm script or the EAS build profile, not by .env.

# Which variant this bundle is: development | preview | production
# Must match the APP_VARIANT used for the build, or the app will report the
# wrong variant at runtime.
EXPO_PUBLIC_APP_VARIANT=development

# Base URL of the API. https is required in preview and production; http is
# allowed only in development, for a local server.
EXPO_PUBLIC_API_URL=https://api.sundaybest.com

# Whether to run the app-attestation flow. Off in development, because it needs
# a real device and a registered bundle ID.
EXPO_PUBLIC_ATTESTATION_ENABLED=false

# Sentry DSN for crash reporting. Optional — leave it empty to disable.
# A DSN is not a secret (it is embedded in every client), but it is per-project.
EXPO_PUBLIC_SENTRY_DSN=
