{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/app/**/*.{ts,tsx}", "src/**/*.test.{ts,tsx}", "test/**/*.{ts,tsx}"],
  "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
  "ignore": [
    "src/features/_template/**",
    "src/features/home/store.ts",
    "src/features/home/types.ts"
