{
  "name": "sundaybest",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.3.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start --go",
    "start:tunnel": "APP_VARIANT=development expo start --go --tunnel",
    "start:dev-build": "APP_VARIANT=development expo start --dev-client",
    "ios": "APP_VARIANT=development expo start --go --ios",
    "dev:mcp": "APP_VARIANT=development EXPO_UNSTABLE_MCP_SERVER=1 expo start --go",
    "icons": "node scripts/generate-icons.mjs",
    "render:intro": "node --no-warnings scripts/intro-movie/render.mjs",
    "build:verses": "node scripts/daily-verses/build.mjs",
    "build:formation": "node scripts/formation/whiten.mjs",
    "build:rise": "api/node_modules/.bin/tsx scripts/rise/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip:check": "knip",
    "check:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-env.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --runInBand",
    "test:related": "jest --findRelatedTests",
    "doctor": "expo-doctor",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run knip:check && npm run check:env && npm run test && npm run doctor",
    "postinstall": "patch-package",
    "build:formation-icons": "node scripts/formation/icons.mjs"
  },
  "dependencies": {
    "@expo/app-integrity": "58.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "5.103.1",
    "expo": "~58.0.19",
    "expo-battery": "~58.0.3",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-updates": "~58.0.18",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "freerasp-react-native": "5.2.1",
    "lucide-react-native": "1.47.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-ssl-public-key-pinning": "1.2.6",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "30.5.2",
    "babel-preset-expo": "~58.0.20",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-testing-library": "7.16.2",
    "expo-doctor": "1.21.5",
    "expo-mcp": "~0.2.1",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "jest-expo": "~58.0.12",
    "knip": "6.35.1",
    "lefthook": "2.1.14",
    "msw": "2.15.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "react-native-svg-transformer": "1.5.3",
    "react-test-renderer": "19.3.0",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "react-dom": "19.3.0"
  }
}
