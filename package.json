{
  "name": "sundaybest",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.3.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "ios": "APP_VARIANT=development expo start --ios",
    "dev:mcp": "APP_VARIANT=development EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip:check": "knip",
    "check:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-env.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --runInBand",
    "test:related": "jest --findRelatedTests",
    "doctor": "expo-doctor",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run knip:check && npm run check:env && npm run test && npm run doctor",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/app-integrity": "57.0.2",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "5.103.1",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "freerasp-react-native": "5.2.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-ssl-public-key-pinning": "1.2.6",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@testing-library/react-native": "13.3.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-jest": "29.7.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-testing-library": "7.16.2",
    "expo-doctor": "1.20.4",
    "expo-mcp": "~0.2.1",
    "globals": "17.12.0",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "knip": "6.35.1",
    "lefthook": "2.1.14",
    "msw": "2.15.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "react-dom": "19.2.3"
  }
}
