NODE_ENV=development
HOST=0.0.0.0
PORT=4100
DATABASE_URL=postgres://sundaybest:sundaybest@localhost:5432/sundaybest

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=sundaybest-api
JWT_AUDIENCE=sundaybest-mobile
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Apple App Attest. Required before production.
APP_ATTEST_TEAM_ID=YOUR_APPLE_TEAM_ID
APP_ATTEST_BUNDLE_ID=com.yourcompany.sundaybest
APP_ATTEST_ALLOW_DEVELOPMENT=true

# Local API/Postman testing only. Startup rejects this in production.
DEV_SESSION_ENABLED=true

# Optional provider gateway URLs. The worker refuses fake production content.
TRANSCRIPT_PROVIDER_URL=
TRANSCRIPT_PROVIDER_TOKEN=
PLAN_GENERATION_PROVIDER_URL=
PLAN_GENERATION_PROVIDER_TOKEN=
BIBLE_PROVIDER_URL=
BIBLE_PROVIDER_TOKEN=

YOUTUBE_OEMBED_BASE_URL=https://www.youtube.com/oembed
WORKER_POLL_MS=1000
WORKER_LOCK_SECONDS=120
WORKER_MAX_ATTEMPTS=3
